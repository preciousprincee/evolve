# Server
PORT=8080
NODE_ENV=development

# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,https://evolve.vercel.app

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key is public by design (same one used in the frontend), but is used
# here server-side to build per-request, RLS-scoped clients (see db/supabaseUserClient.js)
SUPABASE_ANON_KEY=replace-me
# Service role key must NEVER reach the client — server-only
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Groq
GROQ_API_KEY=replace-me

# Long random secret shared with your cron scheduler (Railway Cron / GitHub
# Actions) to authorize the /api/cron/* endpoints. Generate with:
#   openssl rand -hex 32
CRON_SECRET=replace-me
